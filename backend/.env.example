PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_long_random_secret_string

# Used to send Forgot Password OTP emails from the official ClothCore Gmail
# account. EMAIL_PASS must be a Google App Password (Google Account >
# Security > 2-Step Verification > App Passwords) — never the normal Gmail
# login password. Without these set, password reset returns a safe 503 and
# the rest of the app keeps working normally.
EMAIL_USER=your_clothcore_email@gmail.com
EMAIL_PASS=your_google_app_password
EMAIL_FROM_NAME=ClothCore
FRONTEND_URL=http://localhost:3000

# Optional — see backend/config/businessRules.js for dev-only fallback defaults (100 / 50) used when unset
MINIMUM_ORDER_QUANTITY=100
ADVANCE_PAYMENT_PERCENTAGE=50

# Optional — required only for the "Generate with AI" design feature (Order Step 2).
# Uses Hugging Face's free Inference API (no billing needed, just a free account).
# Get a token at https://huggingface.co/settings/tokens (read-access is enough).
# Without it, /api/design/generate responds 503 and customers can still upload a design instead.
HF_API_TOKEN=your_huggingface_access_token
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers